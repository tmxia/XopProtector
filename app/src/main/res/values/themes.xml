<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.XopInk" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorPrimary">@color/ink_black</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
    </style>

    <style name="InkCard">
        <item name="android:background">@drawable/bg_ink_card</item>
    </style>

    <style name="InkSealButton">
        <item name="android:background">@drawable/bg_seal_button</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.3</item>
    </style>

    <style name="InkTag">
        <item name="android:textColor">@color/ink_gray</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.2</item>
    </style>
</resources>
