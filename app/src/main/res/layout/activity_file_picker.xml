<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选 卷"
            android:textColor="@color/ink_black"
            android:textSize="26sp"
            android:letterSpacing="0.3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaf"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_outline"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="系统选择器"
            android:textColor="@color/ink_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 权限引导卡片 -->
    <LinearLayout
        android:id="@+id/cardPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ink_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="需要「所有文件」权限来浏览 APK"
            android:textColor="@color/ink_black"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="内置选卷器直接读取手机里的安装包；也可以点右上角改用系统选择器。"
            android:textColor="@color/ink_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_seal_button"
            android:gravity="center"
            android:text="去 授 权"
            android:textColor="@color/paper"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 当前路径 + 上级 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="/sdcard"
            android:textColor="@color/ink_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnUp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="上一级"
            android:textColor="@color/ink_black"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 快捷目录 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipDownload"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Download"
            android:textColor="@color/ink_black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipDcim"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="DCIM"
            android:textColor="@color/ink_black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_outline"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Bluetooth"
            android:textColor="@color/ink_black"
            android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@color/ink_faint"
        android:dividerHeight="1px" />
</LinearLayout>
